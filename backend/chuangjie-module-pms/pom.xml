            <artifactId>chuangjie-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chuangjie</groupId>
            <artifactId>chuangjie-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.chuangjie</groupId>
            <artifactId>chuangjie-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>com.chuangjie</groupId>
            <artifactId>chuangjie-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.chuangjie</groupId>
            <artifactId>chuangjie-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
